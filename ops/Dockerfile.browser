FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PLAYWRIGHT_BROWSERS_PATH=/opt/playwright-browsers
COPY ops/browser-requirements.txt /tmp/browser-requirements.txt
RUN pip install --no-cache-dir -r /tmp/browser-requirements.txt && \
    apt-get update && apt-get install -y --no-install-recommends libatomic1 && \
    python -m playwright install --with-deps chromium firefox webkit && \
    chmod -R a+rX /opt/playwright-browsers && rm -rf /var/lib/apt/lists/* && \
    useradd --uid 1000 --create-home sem
WORKDIR /app
COPY --chown=sem:sem . .
USER sem
CMD ["python", "-m", "integrations.crawl_renderer_service"]
